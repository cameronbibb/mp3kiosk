<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiosk_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp">
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextClock
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/kiosk_text"
            android:textSize="72sp" />

        <View
            android:id="@+id/adminZone"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="start|center_vertical"
            android:hapticFeedbackEnabled="false"
            android:soundEffectsEnabled="false" />
    </FrameLayout>

    <TextClock
        android:id="@+id/dateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, MMMM d"
        android:format24Hour="EEEE, MMMM d"
        android:textColor="@color/kiosk_text_muted"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/status_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="BATTERY"
                android:textColor="@color/kiosk_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/batteryText"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="20sp"
                android:text="--"
                android:textColor="@color/kiosk_text" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/status_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="STORAGE"
                android:textColor="@color/kiosk_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/storageText"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="20sp"
                android:text="--"
                android:textColor="@color/kiosk_text" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/musicButton"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:text="Music"
        android:textColor="@color/kiosk_on_accent"
        android:textSize="28sp"
        app:backgroundTint="@color/kiosk_accent"
        app:cornerRadius="28dp"
        app:icon="@drawable/spotify_logo_fill_svgrepo_com"
        app:iconGravity="textStart"
        app:iconSize="36dp"
        app:iconTint="@color/kiosk_on_accent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/lockButton"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:text="Lock Kiosk"
        android:textColor="@color/kiosk_on_accent"
        android:textSize="28sp"
        android:visibility="gone"
        app:backgroundTint="@color/kiosk_warning"
        app:cornerRadius="28dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/infoButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/info_link"
        android:textColor="@color/kiosk_text_muted"
        android:textSize="16sp"
        app:icon="@drawable/ic_info"
        app:iconGravity="textStart"
        app:iconTint="@color/kiosk_text_muted" />
</LinearLayout>